# Card GIF for the profile README. Run from a checkout of bhargavchintam/llm-inference:
#   vhs /path/to/bhargavchintam/assets/projects/tapes/llm-inference.tape
Output llm-inference.gif
Require python3
Set Shell "bash"
Set Theme "GitHub Dark"
Set FontSize 26
Set Width 1280
Set Height 720
Set Padding 30
Set WindowBar Colorful
Set BorderRadius 12
Set TypingSpeed 40ms
Type "python3 check_all.py | cut -c1-48"
Sleep 300ms
Enter
Sleep 6s
